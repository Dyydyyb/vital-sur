# Supabase - Conexión directa del cliente (Browser y Servidor)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Base de datos PostgreSQL / Supabase para Prisma ORM (opcional / migraciones)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# URL pública del sitio para metadatos Open Graph y Sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Credenciales de Mercado Pago (Modo Prueba Sandbox)
